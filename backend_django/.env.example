# Copy to .env for local dev; set as env vars in your hosting platform for prod.
# .env is gitignored — never commit real secrets.

# Toggle off in production. Default true (dev).
DJANGO_DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
# REQUIRED in prod (DEBUG=false). The dev fallback is the django-insecure-* default.
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames the app will accept.
# Example prod: raise.onrender.com,raise.usf.edu
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres URL. If unset, falls back to local SQLite at db.sqlite3.
# Render/Neon format: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API and send cookies.
# Example prod: https://raise.vercel.app,https://raise.usf.edu
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
